<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Contact Message - ARVYNO</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f4f4f6;
      color: #18181b;
      margin: 0;
      padding: 35px 15px;
    }
    .wrapper {
      max-width: 620px;
      margin: 0 auto;
      background-color: #ffffff;
      border: 1px solid #e4e4e7;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }
    .header {
      background-color: #ffffff;
      padding: 36px 24px 20px 24px;
      text-align: center;
      border-bottom: 1px solid #f1f1f4;
    }
    .logo-img {
      max-height: 65px;
      width: auto;
      display: inline-block;
      margin-bottom: 10px;
    }
    .brand-subtitle {
      font-size: 11px;
      letter-spacing: 2.5px;
      color: #92722a;
      text-transform: uppercase;
      margin: 0;
      font-weight: 700;
    }
    .content {
      padding: 32px 28px;
    }
    .alert-banner {
      background: #faf8f5;
      border: 1px solid #e8dfd1;
      color: #785a1a;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 24px;
      line-height: 1.5;
      font-weight: 500;
    }
    .section-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #92722a;
      margin: 0 0 16px 0;
      font-weight: 700;
    }
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }
    .info-table td {
      padding: 11px 14px;
      border-bottom: 1px solid #f1f1f4;
      font-size: 14px;
    }
    .info-label {
      color: #71717a;
      width: 35%;
      font-weight: 500;
    }
    .info-value {
      color: #18181b;
      font-weight: 600;
    }
    .highlight-gold {
      color: #92722a;
    }
    .message-box {
      background-color: #fafafa;
      border: 1px solid #e4e4e7;
      border-radius: 8px;
      padding: 18px;
      font-size: 14px;
      line-height: 1.6;
      color: #27272a;
      white-space: pre-line;
      margin-bottom: 24px;
    }
    .footer {
      background-color: #fafafa;
      padding: 24px;
      text-align: center;
      border-top: 1px solid #f1f1f4;
      font-size: 12px;
      color: #71717a;
      line-height: 1.7;
    }
    .footer a {
      color: #92722a;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <img src="https://www.arvynobd.com/images/logo/arvyno-logo.png" alt="ARVYNO" class="logo-img" />
      <p class="brand-subtitle">Customer Contact &amp; Inquiry</p>
    </div>

    <div class="content">
      <div class="alert-banner">
        New customer message received from your website contact form.
      </div>

      <h3 class="section-title">Customer Information</h3>
      <table class="info-table">
        <tr>
          <td class="info-label">Full Name</td>
          <td class="info-value"><%= name %></td>
        </tr>
        <tr>
          <td class="info-label">Mobile / WhatsApp</td>
          <td class="info-value highlight-gold"><%= phone %></td>
        </tr>
        <% if (email && email !== "Not provided") { %>
        <tr>
          <td class="info-label">Email Address</td>
          <td class="info-value"><%= email %></td>
        </tr>
        <% } %>
        <% if (topic && topic !== "GENERAL") { %>
        <tr>
          <td class="info-label">Inquiry Topic</td>
          <td class="info-value"><%= topic %></td>
        </tr>
        <% } %>
        <% if (orderNumber && orderNumber !== "N/A") { %>
        <tr>
          <td class="info-label">Order Reference</td>
          <td class="info-value"><%= orderNumber %></td>
        </tr>
        <% } %>
        <tr>
          <td class="info-label">Date &amp; Time</td>
          <td class="info-value"><%= submittedAt %></td>
        </tr>
      </table>

      <h3 class="section-title">Message / Inquiry Details</h3>
      <div class="message-box">
        <%= message %>
      </div>
    </div>

    <div class="footer">
      <strong>ARVYNO</strong> &bull; Luxury Apparel &amp; Sartorial Essentials<br />
      House-50, Block-F, Road-2, Eastern Housing, Pallabi, Dhaka, Bangladesh, 1216<br />
      Hotline: <a href="tel:+8801886957897">+880 1886-957897</a> &bull; Web: <a href="https://www.arvynobd.com" target="_blank">www.arvynobd.com</a>
    </div>
  </div>
</body>
</html>
